{
  // LiveKit's signalling. Deploy: wrangler deploy -c wrangler.livekit.jsonc
  // Its origin: wrangler secret put ORIGIN_URL -c wrangler.livekit.jsonc
  "name": "aule-livekit",
  "main": "src/livekit.js",
  "compatibility_date": "2025-11-01",
  "routes": [{ "pattern": "livekit.meetaule.com", "custom_domain": true }],
  // No line per request in Cloudflare's logs: the browser sends its room token
  // in the address it connects to. Errors and uncaught exceptions are still logged.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
