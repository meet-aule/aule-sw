{
  // The session page. Deploy: wrangler deploy -c wrangler.playground.jsonc
  // Its origin: wrangler secret put ORIGIN_URL -c wrangler.playground.jsonc
  // The mobile API needs MOBILE_API_ORIGIN and MOBILE_API_ORIGIN_SECRET.
  // Provision its protected tunnel first (README.md).
  "name": "aule-playground-funnel",
  "main": "src/playground.js",
  "compatibility_date": "2025-11-01",
  "routes": [{ "pattern": "playground.meetaule.com", "custom_domain": true }],
  // No line per request in Cloudflare's logs: a sign-in's way back from
  // GitHub or Facebook carries its code in the address, and every line would
  // say who opened which page. Errors and uncaught exceptions are still logged.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
