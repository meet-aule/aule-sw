{
  // The team's console. Deploy: wrangler deploy -c wrangler.admin.jsonc
  // Its origin: wrangler secret put ORIGIN_URL -c wrangler.admin.jsonc
  // What it adds to every request, the console's ADMIN_EDGE_SECRET:
  //   wrangler secret put EDGE_SECRET -c wrangler.admin.jsonc
  "name": "aule-admin",
  "main": "src/admin.js",
  "compatibility_date": "2025-11-01",
  // Only at its own address: no workers.dev name and no preview addresses.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "admin.meetaule.com", "custom_domain": true }],
  // No line per request in Cloudflare's logs; errors and uncaught exceptions are still logged.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
