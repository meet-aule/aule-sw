# Copy to .env (or point AULE_ENV_FILE at your copy) and fill it in.

# LiveKit server the agent connects to, and its API key pair. The platform opens
# each session's room through LiveKit's server API at this address, handing it
# the agent's token, so with the keys it needs this address too, never the public one.
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LiveKit URL as browsers and devices reach it, when it differs from LIVEKIT_URL.
AULE_LIVEKIT_PUBLIC_URL=

# --- Platform and worker (apps/platform) ---
# The database of compose.yaml. Use the same password in both places.
POSTGRES_USER=aule
POSTGRES_DB=aule
POSTGRES_PASSWORD=
DATABASE_URL=postgres://aule:PASSWORD@127.0.0.1:5433/aule
# At least 32 characters. Whoever has it can read and change everything.
AULE_ADMIN_TOKEN=
# Where the agent and the playground find the platform.
AULE_PLATFORM_URL=http://127.0.0.1:8091
# An OpenAI-compatible embeddings API with a 1024-dimension model. The default
# is the local model of compose.yaml, so memories stay on this machine.
AULE_EMBEDDINGS_URL=http://127.0.0.1:11435/v1
#AULE_EMBEDDINGS_MODEL=bge-m3
#AULE_EMBEDDINGS_API_KEY=
# Mail, for sign-in codes and notices to guardians. Without it nobody can sign in.
AULE_SMTP_URL=
AULE_MAIL_FROM=
# Optional: push notifications. Path of the service account key of a Firebase
# project (Project settings > Service accounts > Generate new private key).
# With compose.yaml, give the key's path on this machine in AULE_FCM_KEY_FILE
# (see the top of compose.yaml) and set this to where it is mounted:
#AULE_FCM_SERVICE_ACCOUNT=/run/secrets/firebase.json
# Optional: deliver every event to this URL, signed with the secret (32+ characters).
#AULE_EVENTS_WEBHOOK_URL=
#AULE_EVENTS_WEBHOOK_SECRET=
# Optional: minutes east of UTC that devices are told. Default is Lima.
#AULE_TIMEZONE_OFFSET_MINUTES=-300
# The supervisor uses ANTHROPIC_API_KEY (below). Optional: defaults shown.
#AULE_SUPERVISOR_MODEL=claude-sonnet-5-5
#AULE_SUPERVISOR_LIVE_MODEL=claude-haiku-5-5
#AULE_PLATFORM_ADDR=127.0.0.1:8091
#AULE_SESSION_MINUTES=20
# Minutes of work after which the tutor is told to offer a break (5 to 120).
#AULE_BREAK_EVERY_MINUTES=30
#AULE_TRANSCRIPT_HOURS=24

# --- Agent (apps/agent) ---
# Speech to text: assemblyai | deepgram | openai
AULE_STT=
# Text to speech: cartesia | elevenlabs | inworld | openai
AULE_TTS=
# Optional voice id of the chosen text-to-speech provider.
AULE_TTS_VOICE=
# Only the keys of the providers chosen above are needed.
ANTHROPIC_API_KEY=
ASSEMBLYAI_API_KEY=
DEEPGRAM_API_KEY=
CARTESIA_API_KEY=
ELEVEN_API_KEY=
INWORLD_API_KEY=
# Also turns on the content-moderation gate, whichever speech providers are chosen.
OPENAI_API_KEY=
# Turns on the physical-safety gate (TypeSafe). A child's session needs both gates.
TYPESAFE_API_KEY=
# Optional: defaults shown.
#AULE_AGENT_NAME=aule-tutor
#AULE_LLM_MODEL=claude-sonnet-5-5
#AULE_LANGUAGE=es
#AULE_SESSION_MAX_MINUTES=15
# How long a break lasts before the tutor asks to go on. The platform decides
# when one is due (AULE_BREAK_EVERY_MINUTES).
#AULE_BREAK_MINUTES=5
# Agent processes kept warm, so that many students can join at once without waiting.
#AULE_IDLE_PROCESSES=1
# 1 lets the page's talk button end each turn (hold to talk). Left out, a turn
# ends when the student stops speaking.
#AULE_PUSH_TO_TALK=
# 1 puts the supervisor's guidance and the engine's rules for talk, and the
# output-language rule after them, after the conversation, as a system message,
# so the cached conversation is still read when they change (claude-sonnet-5-5
# only). Left out, they end the system prompt, as before. Check in a live
# session that the tutor never talks about them before turning it on (see #56).
#AULE_NOTES_AFTER_HISTORY=
# 1 asks the model for a turn's reply while the safety gates still judge the
# turn. Nothing of the reply reaches the child before both let it through, but
# the child's words reach the model before they decide, those of a turn they
# stop included (not written to its prompt cache, and with no camera frame).
# AGENTS.md allows no path around the gates: leave it out until the
# maintainer changes that rule. Left out, the model is asked once the gates
# decide.
#AULE_EARLY_REPLY=
# 1 gives the voice a reply's first sentence while the safety gate on what
# the tutor says still judges the reply. Nothing of it is heard before the
# gate approves it, but the voice's provider receives the first sentence of a
# reply the gate then stops. Left out, the voice gets a reply once it passed.
#AULE_VOICE_AHEAD=
# The worker's health endpoint, on loopback unless told otherwise.
#AULE_HEALTH_HOST=127.0.0.1
#AULE_HEALTH_PORT=8081

# --- Playground (apps/playground) ---
# A child profile to try the tutor with, once the platform has one.
#PLAYGROUND_CHILD_ID=
# At least 16 characters. Whoever has it can start a session through the API;
# the page no longer offers it.
PLAYGROUND_ACCESS_CODE=
# Optional: defaults shown.
#PLAYGROUND_HOST=127.0.0.1
#PLAYGROUND_PORT=8090
#PLAYGROUND_BASE_PATH=/playground
#PLAYGROUND_SESSION_MINUTES=20
# Sessions one signed-in account may start in a day. One its tutor never started
# is given back when it is closed, at most this many times a day.
#PLAYGROUND_DAILY_SESSIONS=3
# 1 asks the platform for the session engine in every session a family starts.
# The platform uses it where it covers what the session is for (fractions
# homework, today) and the tutor runs the others. Left out, the tutor runs them
# all. (Formerly PLAYGROUND_FLOW=engine; the old name now stops the page.)
#PLAYGROUND_ENGINE=

# Sign-in with Google for guardians, next to the emailed code: the OAuth web
# client's ID from Google Cloud (not its secret, which is not used).
#AULE_GOOGLE_CLIENT_ID=
# Aule's team, by the addresses they sign in with, separated by commas: they
# also sign in to the team's console, admin.meetaule.com, and reach the daily
# metrics. Read by the platform and the console; a change needs both restarted.
#AULE_ADMIN_EMAILS=
# Temporary free access: 1 removes plan quotas/trial expiry and the web daily
# session cap. Set on both platform and playground. Default 0 restores plans;
# sign-in, consent, staff permissions and session duration are unchanged.
#AULE_FREE_ACCESS=0
# Where people reach the page, like https://playground.example.org. GitHub, Meta
# and Apple send people back to it; without it the page does not offer them.
#PLAYGROUND_PUBLIC_URL=
# Sign-in with GitHub: an OAuth app whose callback is
# <PLAYGROUND_PUBLIC_URL><base path>/api/signin/github/callback.
#AULE_GITHUB_CLIENT_ID=
#AULE_GITHUB_CLIENT_SECRET=
# Sign-in with Facebook: a Meta app with Facebook Login, redirect URI
# .../api/signin/meta/callback.
#AULE_META_APP_ID=
#AULE_META_APP_SECRET=
# Sign-in with Apple: a Services ID (return URL .../api/signin/apple/callback),
# the team's ID, and a Sign in with Apple key: its ID and its .p8 file in base64.
#AULE_APPLE_SERVICES_ID=
#AULE_APPLE_TEAM_ID=
#AULE_APPLE_KEY_ID=
#AULE_APPLE_PRIVATE_KEY=

# --- Team console (apps/admin) ---
# It reads AULE_PLATFORM_URL and AULE_ADMIN_EMAILS above, and never the
# operator's token: its image starts it with its own settings only.
# Optional: defaults shown. With compose.yaml, ADMIN_HOST comes from the
# shell's AULE_ADMIN_HOST (see the top of compose.yaml).
#ADMIN_HOST=127.0.0.1
#ADMIN_PORT=8092
# Where the team reaches it: the one Origin a write may carry.
#ADMIN_PUBLIC_URL=https://admin.meetaule.com
# The secret its Worker adds to every request (the Worker's EDGE_SECRET), at
# least 32 characters (openssl rand -hex 32). Set, a request without it gets a
# 404; it is required to listen beyond loopback. On the server it is kept in
# the console's own env file, not in this one (infra/server/README.md).
#ADMIN_EDGE_SECRET=
