{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/meet-aule/aule-sw/contracts/board/view.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "scene": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "bars"
            },
            "rows": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 12
                  },
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 12
                  }
                ],
                "items": false
              }
            },
            "mark": {
              "type": "string",
              "pattern": "^(top|right|bottom|left|r[1-4]c([1-9]|1[0-2]))$"
            }
          },
          "required": [
            "kind",
            "rows"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "rectangle"
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "mark": {
              "type": "string",
              "pattern": "^(top|right|bottom|left|r[1-4]c([1-9]|1[0-2]))$"
            }
          },
          "required": [
            "kind",
            "width",
            "height"
          ]
        }
      ]
    },
    "point": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(top|right|bottom|left|r[1-4]c([1-9]|1[0-2]))$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "revision",
    "scene",
    "point"
  ]
}
